{
  "manifest_version": 3,
  "name": "Stacked PRs for GitHub",
  "short_name": "Stacked PRs",
  "version": "1.8.1",
  "description": "Stacked PRs, review SLAs, token search, issue cards, tbgs code search, and the decisions behind agent-written PRs.",
  "minimum_chrome_version": "111",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://api.github.com/*",
    "https://*.ghe.com/*"
  ],
  "optional_host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "options_page": "options/options.html",
  "omnibox": {
    "keyword": "tbgs"
  },
  "action": {
    "default_title": "Stacked PRs for GitHub settings",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://github.com/*",
        "https://*.ghe.com/*"
      ],
      "js": [
        "src/shared/work-hours.js",
        "src/shared/review-status.js",
        "src/shared/stacks.js",
        "src/shared/activity.js",
        "src/shared/search.js",
        "src/shared/code-search.js",
        "src/shared/intent-view.js",
        "src/content/octicons.js",
        "src/content/api.js",
        "src/content/render.js",
        "src/content/activity-popover.js",
        "src/content/search-bar.js",
        "src/content/list-view.js",
        "src/content/issue-view.js",
        "src/content/stack-navigator.js",
        "src/content/code-search-bar.js",
        "src/content/intent-trail.js",
        "src/content/main.js"
      ],
      "css": [
        "src/content/styles.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
